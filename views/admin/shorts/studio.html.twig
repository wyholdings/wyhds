{% extends 'admin/layout/base.html.twig' %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0 text-gray-800">쇼츠 스튜디오</h1>
        <p class="text-muted mb-0">키워드에 맞는 Pixabay 동영상에 내레이션과 자막을 더해 세로 쇼츠를 만듭니다.</p>
    </div>
</div>

{% if flash %}
<div class="alert alert-{{ flash.type }}">{{ flash.message }}</div>
{% endif %}

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">즉시 생성</h6>
            </div>
            <div class="card-body">
                <form id="shorts-generation-form" method="post" enctype="multipart/form-data" action="/admin/shorts/studio">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="request_token" value="{{ request_token }}">
                    <div class="form-group">
                        <label>키워드</label>
                        <input type="text" name="keyword" class="form-control" value="{{ form.keyword }}" placeholder="예: 조선시대 미스터리, 부업 자동화, 고양이 상식" required>
                    </div>
                    <div class="form-group">
                        <label>톤</label>
                        <select name="tone" class="form-control">
                            <option value="clickable" {% if form.tone == 'clickable' %}selected{% endif %}>클릭 유도형</option>
                            <option value="calm" {% if form.tone == 'calm' %}selected{% endif %}>차분한 정보형</option>
                            <option value="dramatic" {% if form.tone == 'dramatic' %}selected{% endif %}>강한 훅형</option>
                            <option value="fast" {% if form.tone == 'fast' %}selected{% endif %}>빠른 템포형</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>목표 길이(초)</label>
                        <input type="number" min="30" max="90" name="duration" class="form-control date-input" value="{{ form.duration }}">
                    </div>
                    <div class="form-group">
                        <label>음성 서비스</label>
                        <select name="tts_provider" id="tts-provider" class="form-control">
                            <option value="google" {% if (form.tts_provider ?? 'google') == 'google' %}selected{% endif %}>Google · 한국어 Chirp 3 HD</option>
                            <option value="openai" {% if form.tts_provider == 'openai' %}selected{% endif %}>OpenAI</option>
                        </select>
                        <small class="form-text text-muted">Google 음성은 무료 구간이 있으며 결제 연결이 필요합니다. 무료 한도 초과분은 과금됩니다.</small>
                    </div>
                    <div class="form-group">
                        <label>TTS 보이스</label>
                        <select name="voice" class="form-control">
                            {% for voice, label in google_voices %}
                            <option data-provider="google" value="{{ voice }}" {% if form.voice == voice %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                            {% for voice in voices %}
                            <option data-provider="openai" value="{{ voice }}" {% if form.voice == voice %}selected{% endif %}>{{ voice }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-7" id="openai-speech-style">
                            <label>음성 말투</label>
                            <select name="speech_style" class="form-control">
                                <option value="natural" {% if (form.speech_style ?? 'natural') == 'natural' %}selected{% endif %}>자연스러운 설명</option>
                                <option value="calm" {% if form.speech_style == 'calm' %}selected{% endif %}>차분한 내레이션</option>
                                <option value="bright" {% if form.speech_style == 'bright' %}selected{% endif %}>밝고 경쾌하게</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-5">
                            <label>말하기 속도</label>
                            <select name="speech_speed" class="form-control">
                                <option value="0.9" {% if form.speech_speed == 0.9 %}selected{% endif %}>여유롭게 · 0.9배</option>
                                <option value="1" {% if (form.speech_speed ?? 1) == 1 %}selected{% endif %}>보통 · 1배</option>
                                <option value="1.1" {% if form.speech_speed == 1.1 %}selected{% endif %}>빠르게 · 1.1배</option>
                            </select>
                        </div>
                    </div>
                    <p class="small text-muted">읽는 문장을 그대로 자막으로 표시하고, 발화 문단별 길이에 맞춰 자막과 장면을 배치합니다.</p>
                    <div class="form-group">
                        <label>배경음악</label>
                        <select name="bgm_mode" id="bgm-mode" class="form-control">
                            <option value="default" {% if (form.bgm_mode ?? 'default') == 'default' %}selected{% endif %}>기본 음악 · 서버 설정 또는 잔잔한 앰비언트</option>
                            <option value="upload" {% if form.bgm_mode == 'upload' %}selected{% endif %}>내 음악 업로드</option>
                            <option value="off" {% if form.bgm_mode == 'off' %}selected{% endif %}>음악 없음</option>
                        </select>
                        <div id="bgm-upload" class="mt-2">
                            <input type="file" name="bgm_file" class="form-control-file" accept=".mp3,.wav,.m4a,.ogg,.flac">
                            <small class="form-text text-muted">사용 권한이 있는 음악을 올려주세요. 최대 20MB · 새 요청에는 파일을 다시 선택해야 합니다.</small>
                        </div>
                        <label class="mt-2" for="bgm-volume">음악 크기 · <span id="bgm-volume-label">{{ form.bgm_volume ?? 12 }}</span>%</label>
                        <input type="range" id="bgm-volume" name="bgm_volume" min="0" max="30" value="{{ form.bgm_volume ?? 12 }}" class="custom-range">
                        <small class="form-text text-muted">말할 때 음악을 더 낮추고, 영상 끝에서 서서히 줄입니다.</small>
                        <details class="mt-2 small"><summary>기본 앰비언트 들어보기</summary><audio controls preload="none" class="w-100 mt-2" src="/assets/bgm/shorts-ambient.m4a"></audio></details>
                    </div>
                    <div class="form-group">
                        <label>영상 검색어 <span class="text-muted">(선택)</span></label>
                        <input type="text" name="stock_keyword" maxlength="100" class="form-control" value="{{ form.stock_keyword ?? '' }}" placeholder="예: bedroom, coffee, cat">
                        <small class="form-text text-muted">비워 두면 대본에 맞춰 자동 검색합니다. 원하는 장면이 있다면 짧은 영어 검색어를 입력하세요.</small>
                    </div>
                    <p class="small text-muted">영상 소스: <a href="https://pixabay.com/videos/" target="_blank" rel="noopener noreferrer">Pixabay</a> · 대본은 OpenAI, 음성은 선택한 서비스의 요금이 적용됩니다.</p>
                    <button type="submit" class="btn btn-primary btn-block">영상 생성 실행</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">환경 체크</h6>
            </div>
            <div class="card-body small">
                <div class="mb-2"><strong>텍스트 모델:</strong> {{ openai_model }}</div>
                <div class="mb-2"><strong>영상 소스:</strong> Pixabay · {{ pixabay_configured ? '키 설정됨' : '키 미설정' }}</div>
                <div class="mb-2"><strong>검색 캐시:</strong> {{ pixabay_cache_root }}</div>
                {% if not pixabay_configured %}
                <div class="alert alert-warning">서버 .env에 PIXABAY_API_KEY를 설정하세요. <a href="https://pixabay.com/api/docs/#api_search_videos" target="_blank" rel="noopener noreferrer">API 문서에 로그인해 키 확인하기</a></div>
                {% endif %}
                <div class="mb-2"><strong>Google TTS:</strong> {{ google_tts_configured ? '키 설정됨' : 'GOOGLE_TTS_API_KEY 설정 필요' }}</div>
                <div class="mb-2"><strong>OpenAI TTS:</strong> {{ tts_model }}</div>
                <div class="mb-2"><strong>출력 루트:</strong> {{ output_root }}</div>
                <div class="mb-2"><strong>FFmpeg 경로:</strong> {{ ffmpeg_path ?: '미설정' }}</div>
                <div class="mb-2"><strong>BGM 경로:</strong> {{ bgm_path ?: '미설정' }}</div>
                <div class="text-muted">OPENAI_API_KEY, PIXABAY_API_KEY와 출력·캐시 폴더 권한을 확인하세요. SHORTS_BGM_PATH가 있으면 배경음악을 자동으로 섞습니다.</div>
            </div>
        </div>
    </div>

    <div class="col-lg-7 mb-4">
        {% if result %}
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">생성 결과</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <video class="w-100 studio-video" controls preload="metadata" poster="{{ result.cover_url }}">
                        <source src="{{ result.video_url }}" type="video/mp4">
                    </video>
                </div>
                <div class="mb-3">
                    <label class="small text-muted">최종 오디오 듣기</label>
                    <audio class="w-100" controls preload="metadata" src="{{ result.audio_url }}"></audio>
                    {% if result.script._narration_url ?? null %}
                    <label class="small text-muted mt-2">내레이션만 듣기 · {{ result.script._tts_voice ?? '' }}</label>
                    <audio class="w-100" controls preload="none" src="{{ result.script._narration_url }}"></audio>
                    {% endif %}
                </div>
                {% if result.subtitle_url %}
                <a href="{{ result.subtitle_url }}" download class="btn btn-sm btn-outline-primary mb-3">자막 파일 다운로드 · SRT</a>
                {% endif %}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <a href="{{ result.cover_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-block">커버 이미지 열기</a>
                    </div>
                    <div class="col-md-6 mb-3">
                        <a href="{{ result.audio_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-block">음성 파일 열기</a>
                    </div>
                </div>
                {% if result.scene_image_urls %}
                <div class="row mb-3">
                    {% for image_url in result.scene_image_urls %}
                    <div class="col-md-4 mb-3">
                        <a href="{{ image_url }}" target="_blank" rel="noopener noreferrer">
                            <img src="{{ image_url }}" alt="scene {{ loop.index }}" class="img-fluid rounded border">
                        </a>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                {% if result.script._video_sources ?? [] %}
                <div class="small mb-3">
                    <strong>사용한 영상 · <a href="https://pixabay.com/videos/" target="_blank" rel="noopener noreferrer">Pixabay</a></strong>
                    <ul class="mb-0 mt-1">
                        {% for source in result.script._video_sources %}
                        <li><a href="{{ source.page_url }}" target="_blank" rel="noopener noreferrer">장면 {{ loop.index }} · {{ source.user }}</a> <span class="text-muted">{{ source.query }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
                <div class="form-group">
                    <label><strong>제목</strong></label>
                    <div class="prompt-box">{{ result.script.video_title }}</div>
                </div>
                <div class="form-group">
                    <label><strong>내레이션</strong></label>
                    <div class="prompt-box">{{ result.script.narration }}</div>
                </div>
                <div class="form-group mb-0">
                    <label><strong>해시태그</strong></label>
                    <div class="prompt-box">{% for tag in result.script.hashtags %}#{{ tag }} {% endfor %}</div>
                </div>
                <div class="small text-muted mt-3">
                    모델 {{ openai_model }}<br>
                    cached_tokens {{ result.script._cached_tokens ?? 0 }}
                </div>
            </div>
        </div>
        {% endif %}

        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">최근 생성 기록</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>키워드</th>
                                <th>생성일</th>
                                <th>상태</th>
                                <th>결과</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for render in renders %}
                            <tr>
                                <td class="text-muted">{{ render.id }}</td>
                                <td>
                                    {{ render.keyword }}
                                    {% if render.script and render.script.video_title %}
                                    <div class="small text-muted">{{ render.script.video_title }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ render.created_at }}</td>
                                <td><span class="badge badge-status badge-{{ render.status }}">{{ render.status }}</span></td>
                                <td>
                                    {% if render.video_url %}
                                    <a href="/admin/shorts/studio?render={{ render.id }}" class="btn btn-sm btn-outline-secondary">결과 보기</a>
                                    <a href="{{ render.video_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info">영상</a>
                                    {% endif %}
                                    {% if render.error_message %}
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-toggle="modal" data-target="#errorModal{{ render.id }}">오류</button>
                                    <div class="modal fade" id="errorModal{{ render.id }}" tabindex="-1" role="dialog" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">오류 상세</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="prompt-box">{{ render.error_message }}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted p-4">생성 기록이 없습니다.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const form = document.getElementById('shorts-generation-form');
    const button = form.querySelector('button[type="submit"]');
    const provider = form.querySelector('[name="tts_provider"]');
    const voice = form.querySelector('[name="voice"]');
    const music = form.querySelector('[name="bgm_mode"]');
    const updateOptions = () => {
        for (const option of voice.options) {
            option.disabled = option.dataset.provider !== provider.value;
            option.hidden = option.disabled;
        }
        if (!voice.selectedOptions.length || voice.selectedOptions[0].disabled) {
            voice.value = Array.from(voice.options).find(option => !option.disabled)?.value ?? '';
        }
        document.getElementById('openai-speech-style').hidden = provider.value !== 'openai';
        form.querySelector('[name="speech_style"]').disabled = provider.value !== 'openai';
        document.getElementById('bgm-upload').hidden = music.value !== 'upload';
        form.querySelector('[name="bgm_file"]').required = music.value === 'upload';
        form.querySelector('[name="bgm_file"]').disabled = music.value !== 'upload';
        document.getElementById('bgm-volume').disabled = music.value === 'off';
    };
    provider.addEventListener('change', updateOptions);
    music.addEventListener('change', updateOptions);
    document.getElementById('bgm-volume').addEventListener('input', event => {
        document.getElementById('bgm-volume-label').textContent = event.target.value;
    });
    updateOptions();
    form.addEventListener('submit', (event) => {
        if (form.dataset.submitting === '1') {
            event.preventDefault();
            return;
        }
        form.dataset.submitting = '1';
        button.disabled = true;
        button.textContent = '영상 생성 중…';
    });
    window.addEventListener('pageshow', () => {
        delete form.dataset.submitting;
        button.disabled = false;
        button.textContent = '영상 생성 실행';
    });
})();
</script>
{% endblock %}
